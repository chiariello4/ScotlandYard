[sub_resource type="GDScript" id="GDScript_ea181"]
script/source = "extends Node2D

#@onready var message_1: Label = $PanelContainer/MarginContainer/VBoxContainer/Message_1
#@onready var message_2: Label = $PanelContainer/MarginContainer/VBoxContainer/Message_2
#@onready var message_3: Label = $PanelContainer/MarginContainer/VBoxContainer/Message_3
#@onready var button_ok: Button = $PanelContainer/MarginContainer/VBoxContainer/MarginContainer/HBoxContainer/Button_OK
#@onready var button_cancel: Button = $PanelContainer/MarginContainer/VBoxContainer/MarginContainer/HBoxContainer/Button_Cancel
#@onready var ack_type : int # Acknowledgement type
#
#signal message_ack(type)
#
#func _on_main_game_over(type: Variant, agent: Variant) -> void:
	#message_1.text = \"Game Over\"
	#message_3.visible = true
	#ack_type = 1 # GlobalEnums.message_type.GAME_OVER
	#match type:
		#GlobalEnums.win_type.CAPTURE:
			#var message2text : String
			#button_cancel.visible = true
			#message2text = \"Suspect captured by Agent\"
			#message2text += str(agent)
			#message_2.text = message2text
			#message_3.text = \"Play again?\"
		#GlobalEnums.win_type.SURROUNDED:
			#button_cancel.visible = true
			#message_2.text = \"Suspect is surrounded\"
			#message_3.text = \"Play again?\"
	#visible = true
#
#func _on_button_ok_pressed() -> void:
	#message_3.visible = false
	#button_cancel.visible = false
	#visible = false
	#emit_signal(\"message_ack\",ack_type)
#
#func _on_button_cancel_pressed() -> void:
	#visible = false
"

