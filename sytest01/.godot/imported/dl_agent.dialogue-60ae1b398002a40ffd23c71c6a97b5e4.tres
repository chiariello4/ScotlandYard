&"id": "274",
&"next_id": "275",
&"type": "title"
},
"275": {
&"character": "Fay",
&"id": "275",
&"next_id": "276",
&"text": "Hoo. Right. Huff. I've been walking all day. Can I stop here and take a break?",
&"type": "dialogue"
},
"276": {
&"character": "Dispatcher",
&"id": "276",
&"next_id": "277",
&"text": "Are you saying you can't get to that location?",
&"type": "dialogue"
},
"277": {
&"character": "Fay",
&"id": "277",
&"next_id": "278",
&"text": "I can. ... I mean, I can't. I need to rest for a few minutes. Is that okay?",
&"type": "dialogue"
},
"278": {
&"character": "Dispatcher",
&"id": "278",
&"next_id": "279",
&"text": "We are working as a team to close in on our suspect. But if you are unable to move at this time, then go ahead and rest.",
&"type": "dialogue"
},
"279": {
&"character": "Fay",
&"id": "279",
&"next_id": "280",
&"text": "Thanks. I'll be ready to go in a few minutes.",
&"type": "dialogue"
},
