},
"243": {
&"character": "Dolly",
&"id": "243",
&"next_id": "244",
&"text": "The ground is wet.",
&"type": "dialogue"
},
"244": {
&"character": "Dispatcher",
&"id": "244",
&"next_id": "245",
&"text": "Did I understand you correctly ... that the ground is wet?",
&"type": "dialogue"
},
"245": {
&"character": "Dolly",
&"id": "245",
&"next_id": "246",
&"text": "I'm wearning heals, and ...",
&"type": "dialogue"
},
"246": {
&"character": "Dispatcher",
&"id": "246",
&"next_id": "247",
&"text": "You may be doing a lot of walking today, and yes, it may be muddy. Put on some comfortable shoes now.",
&"type": "dialogue"
},
"247": {
&"character": "Dolly",
&"id": "247",
&"next_id": "248",
&"text": "Yes, sir.",
&"type": "dialogue"
},
