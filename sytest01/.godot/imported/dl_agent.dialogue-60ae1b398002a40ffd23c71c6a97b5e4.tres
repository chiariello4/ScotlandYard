"261": {
&"character": "Dispatcher",
&"id": "261",
&"next_id": "262",
&"text": "Edouard, you were asked to move to location {{GlobalVars.original_location_name}}.",
&"text_replacements": Array[Dictionary]([{
&"expression": Array[Dictionary]([{
&"i": 58,
&"type": &"variable",
&"value": "GlobalVars"
