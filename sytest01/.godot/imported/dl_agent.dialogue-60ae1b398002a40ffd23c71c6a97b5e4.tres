}]),
&"type": "dialogue"
},
"262": {
&"character": "Edouard",
&"id": "262",
&"next_id": "263",
&"text": "I tried. I seem to have gotten lost on the path somewhere, and now I think I'm back where I started from.",
&"type": "dialogue"
},
"263": {
&"character": "Dispatcher",
&"id": "263",
&"next_id": "264",
&"text": "You got lost? ... Okay, just stay there and familiarize yourself with the area so it doesn't happen again.",
&"type": "dialogue"
},
"264": {
&"character": "Edouard",
&"id": "264",
&"next_id": "265",
&"text": "Yes, sir.",
&"type": "dialogue"
},
"265": {
&"id": "265",
&"is_snippet": false,
&"next_id": "end",
&"next_id_after": "",
&"type": "goto"
},
