"241": {
&"character": "Dolly",
&"id": "241",
&"next_id": "242",
&"text": "Can you send me to a different location?",
&"type": "dialogue"
},
"242": {
&"character": "Dispatcher",
&"id": "242",
&"next_id": "243",
&"text": "Is there a problem at {{GlobalVars.original_location_name}}?",
&"text_replacements": Array[Dictionary]([{
&"expression": Array[Dictionary]([{
&"i": 36,
&"type": &"variable",
&"value": "GlobalVars"
