&"id": "267",
&"next_id": "268",
&"type": "title"
},
"268": {
&"character": "Dispatcher",
&"id": "268",
&"next_id": "269",
&"text": "Edouard, you're still in the same location. Don't tell me you got lost again.",
&"type": "dialogue"
},
"269": {
&"character": "Edouard",
&"id": "269",
&"next_id": "270",
&"text": "Wow, you're right. I [i]am[/i] back to where I started. How funny is that?",
&"type": "dialogue"
},
"27": {
&"id": "27",
&"next_id": "28",
&"type": "title"
},
"270": {
&"character": "Dispatcher",
&"id": "270",
&"next_id": "271",
&"text": "Yeah, that's really funny. Now please, be more carful when you're given an assignment, okay?",
&"type": "dialogue"
},
"271": {
&"character": "Edouard",
&"id": "271",
&"next_id": "272",
&"text": "I will. I just find it so disorienting. I'm not a 'walk in the woods' guy.",
&"type": "dialogue"
},
"272": {
&"id": "272",
&"is_snippet": false,
&"next_id": "end",
&"next_id_after": "",
&"type": "goto"
},
