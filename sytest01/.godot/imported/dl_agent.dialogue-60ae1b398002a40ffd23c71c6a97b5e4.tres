&"next_id": "251",
&"type": "title"
},
"251": {
&"character": "Dolly",
&"id": "251",
&"next_id": "252",
&"text": "That path doesn't look well maintained.",
&"type": "dialogue"
},
"252": {
&"character": "Dispatcher",
&"id": "252",
&"next_id": "253",
&"text": "Excuse me?",
&"type": "dialogue"
},
"253": {
&"character": "Dolly",
&"id": "253",
&"next_id": "254",
&"text": "My knit sweater is definitely going to get snagged on branches along that path.",
&"type": "dialogue"
},
"254": {
&"character": "Dispatcher",
&"id": "254",
&"next_id": "255",
&"text": "Your knit sweater? Are you also concerned about getting stains on your chinos?",
&"type": "dialogue"
},
"255": {
&"character": "Dolly",
&"id": "255",
&"next_id": "256",
&"text": "Now that you mention it ...",
&"type": "dialogue"
},
"256": {
&"character": "Dispatcher",
&"id": "256",
&"next_id": "257",
&"text": "Look, Dolly, next time dress appropriately for the assignment. Get yourself ready to move next turn.",
&"type": "dialogue"
},
"257": {
&"character": "Dolly",
&"id": "257",
&"next_id": "258",
&"text": "I understand.",
&"type": "dialogue"
},
"258": {
&"id": "258",
&"is_snippet": false,
&"next_id": "end",
&"next_id_after": "",
