raw_text = "~ start
#Nathan: [[Hi|Hello|Howdy]], this is some dialogue.
#Nathan: Here are some choices.
#- First one
#	Nathan: You picked the first one.
#- Second one
#	Nathan: You picked the second one.
#- Start again => start
#- End the conversation => END
#Nathan: For more information see the online documentation.
Chief: Hi. Welcome to Sparta, New Jersey. I'm the police chief. We can use your help. Are you interested?
- Yes, what can I do?
	Chief: Great. There are a few suspects that you can track down for us.
	Chief: You'll be working closely with our dispatcher.
	Dispatcher: Hi. I'm Sparta's dispatcher. I'll be your contact at headquarters.
- Quit
	Chief: [[I knew you weren't up to it.|Fine, stop wasting my time, then.|Okay, maybe next time.]]
=> END"
metadata/dialogue_manager_version = "3.10.4"
