; Engine configuration file.
; It's best edited using the editor UI and not directly,
; since the parameters that go here are not all obvious.
;
; Format:
;   [section] ; section goes between []
;   param=value ; assign values to parameters

config_version=5

[animation]

compatibility/default_parent_skeleton_in_mesh_instance_3d=true

[application]

config/name="Spartan Pursuit"
config/description="Working version of Spartan Pursuit"
run/main_scene="uid://neeky3ixufpl"
config/features=PackedStringArray("4.7", "GL Compatibility")
config/icon="res://icon.svg"

[autoload]

JsonHandler="*res://singleton/json_handler.gd"
GlobalVars="*res://singleton/global_vars.gd"
GloblalEnums="*res://singleton/globlal_enums.gd"
DialogueManager="*res://addons/dialogue_manager/dialogue_manager.gd"

[dialogue_manager]

runtime/balloon_path="res://dialog/balloon.tscn"
editor/advanced/custom_test_scene_path="uid://dfilb7m3n8kpo"

[display]

window/size/viewport_width=1280
window/size/viewport_height=720
window/size/mode=3
window/subwindows/embed_subwindows=false
window/stretch/scale_mode="integer"

[editor_plugins]

enabled=PackedStringArray("res://addons/dialogue_manager/plugin.cfg")

